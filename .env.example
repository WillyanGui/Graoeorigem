# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local SaaS development
PORT="3333"
DATABASE_URL="postgresql://grao_origem:grao_origem@localhost:5433/grao_origem"
VITE_API_URL="http://localhost:3333"
JWT_SECRET="change-me-in-production"

# External integrations — always use sandbox credentials during development.
SHIPPING_PROVIDER="mock"
MELHOR_ENVIO_BASE_URL="https://sandbox.melhorenvio.com.br"
MELHOR_ENVIO_ACCESS_TOKEN="sandbox-token"
MELHOR_ENVIO_APP_SECRET="sandbox-app-secret"
MELHOR_ENVIO_USER_AGENT="Grao e Origem (contato-tecnico@example.com)"
SHIPPING_QUOTE_TTL_SECONDS="900"
SHIPPING_PROMISE_MARGIN_DAYS="1"

PAYMENT_PROVIDER="mock"
PAYOUT_PROVIDER="manual"
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY="sandbox-api-key"
ASAAS_WEBHOOK_TOKEN="sandbox-webhook-token-at-least-32-characters"
ASAAS_PAYMENT_DUE_DAYS="1"
ASAAS_TIMEOUT_MS="12000"

# Public HTTPS endpoint used by provider webhooks during local development.
PUBLIC_WEBHOOK_BASE_URL="https://replace-with-your-tunnel.example.com"

# 32-byte key, encoded according to the implementation chosen for protected Pix data.
PAYMENT_DATA_ENCRYPTION_KEY="replace-with-a-secure-development-key"

# Commercial rule used to create sandbox SellerPayable records. Zero is the safe default.
PLATFORM_COMMISSION_BPS="0"
