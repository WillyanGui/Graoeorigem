{$DOMAIN} {
    encode zstd gzip

    @backend path /api/* /health
    reverse_proxy @backend api:3333
    reverse_proxy web:80

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
}
